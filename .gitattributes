# Enforce binary handling for media and documents
*.png binary
*.webp binary
*.mp4 binary
*.pdf binary
*.ico binary
*.jpg binary
*.jpeg binary

# Enforce LF normalization for source code and documentation
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
